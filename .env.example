# Скопировать в .env и заполнить. Файл .env в git не попадает.
BOT_TOKEN=
VISION_API_KEY=
# system — обычная работа; nightscout — время с сервера Nightscout (демо с fake_cgm --speed)
CLOCK=system
DATABASE_URL=sqlite:///data/diabetrics.db
# Период опроса Nightscout, секунды. Для демо с --speed 30 ставить 5.
POLL_SECONDS=60
LOG_LEVEL=INFO
# Порт /health (внешняя проверка, что бот жив). 0 — выключить.
HEALTH_PORT=8080

# --- демо с фейковым Nightscout (docker compose --profile demo up -d) ---
# SCENARIO=night_hypo
# SPEED=30
# SKIP=150
# FAKE_NS_TOKEN=secret
